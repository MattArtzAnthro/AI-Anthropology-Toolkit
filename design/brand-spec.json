    "rules": [
      {
        "rule": "action means you can do this",
        "reason": "Primary buttons, selected choices, links and the current stage. Text on it is on-action."
      },
      {
        "rule": "attention is only the Needs-you status",
        "reason": "and the current segment of Progress. It is the loudest colour in the system and is never decoration."
      },
      {
        "rule": "done, refusal and model keep one meaning each",
        "reason": "done is recorded results, refusal is errors and server refusals with a sentence, model is what the model wrote that nobody has decided."
      },
      {
        "rule": "Code colours are marks, never text",
        "reason": "code-1 to code-6 colour dots, lines and nodes. A code keeps the same tone everywhere; past six, repeat with the name shown."
      },
      {
        "rule": "line is decorative only",
        "reason": "Control borders use line-strong, which meets 3:1. focus is an alias of action."
      }
    ],
